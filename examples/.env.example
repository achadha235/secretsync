# Placeholder env for examples/secretsync.yaml and
# examples/secretsync.github-vercel.yaml.
# SecretSync does not load this file automatically — export vars or use:
#   set -a && source examples/.env.example && set +a
#   op run --env-file=.env -- secretsync --config examples/secretsync.yaml validate
#
# Placeholders are enough for validate/plan. Apply needs real provider tokens
# (and for SST: sst/bunx on PATH, a real workingDirectory, and AWS_*).

YB_DATABASE_URL=postgres://user:pass@localhost:5432/app
YB_STAGING_DATABASE_URL=postgres://user:pass@localhost:5432/app_staging
STRIPE_SECRET_KEY=sk_test_placeholder
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
GITHUB_TOKEN=ghp_placeholder_not_a_real_token
VERCEL_TOKEN=vercel_placeholder_not_a_real_token
