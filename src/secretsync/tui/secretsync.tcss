/* SecretSync TUI — status uses text labels; color is never the sole cue. */

Screen {
    layout: vertical;
}

Header {
    dock: top;
}

Footer {
    dock: bottom;
}

#body {
    height: 1fr;
    padding: 1 2;
}

.title {
    text-style: bold;
    margin-bottom: 1;
}

.status-ok {
    text-style: bold;
}

.status-fail {
    text-style: bold;
}

.status-run {
    text-style: bold;
}

.warning {
    margin: 1 0;
    text-style: bold;
}

.button-row {
    height: auto;
    margin-top: 1;
    align: left middle;
}

.button-row Button {
    margin-right: 1;
}

#issues {
    height: 1fr;
    border: solid $surface;
    padding: 0 1;
}

#plan-tree {
    height: 1fr;
    border: solid $surface;
}

#progress-log {
    height: 1fr;
    border: solid $surface;
    padding: 0 1;
}

#results-table {
    height: 1fr;
}

#filter-input, #config-path {
    margin-bottom: 1;
}
